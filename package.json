{
  "license": "ISC",
  "scripts": {
    "build": "anchor build && npm run program:sync",
    "deploy": "npm run build && anchor deploy",
    "reset": "solana-test-validator --reset --quiet --ledger .anchor/test-ledger & sleep 5 && solana config set --url localhost && anchor keys sync && anchor build && anchor deploy && npm run program:sync",
    "start:local": "npm run reset && echo 'Validator ready at http://127.0.0.1:8899'",
    "validator": "solana-test-validator --ledger .anchor/test-ledger --quiet",
    "build:frontend": "npm --prefix app run build",
    "program:sync": "npx tsx scripts/sync-program-id.ts",
    "simulate": "npx tsx scripts/simulate-traders.ts",
    "seed:devnet": "npx tsx scripts/seed-devnet.ts",
    "dev": "npm --prefix app run dev",
    "dev:full": "npm --prefix app run dev:full",
    "test": "ts-mocha tests/unit/*.test.ts",
    "test:anchor": "ts-mocha tests/solpredict.ts",
    "test:all": "npm run test && npm run test:anchor",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.15",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "drizzle-kit": "^0.31.10",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
