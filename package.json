{
  "license": "ISC",
  "scripts": {
    "build": "anchor build && npm run program:sync",
    "deploy": "npm run build && anchor deploy",
    "reset": "solana-test-validator --reset --quiet & sleep 3 && npm run deploy",
    "build:frontend": "npm --prefix app run build",
    "program:sync": "npx tsx scripts/sync-program-id.ts",
    "simulate": "npx tsx scripts/simulate-traders.ts",
    "dev": "npm --prefix app run dev",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.15",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
