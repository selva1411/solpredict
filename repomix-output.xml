@import "tailwindcss";

@theme {
  --color-space-deep: #050510;
  --color-space-dark: #0B0B1E;
  --color-yes-green: #10E58C;
  --color-no-coral: #FF4D6D;
  --color-text-primary: #F8FAFC;
  --color-text-muted: #94A3B8;
  
  --radius-glass: 20px;
  
  --font-display: var(--font-space-grotesk);
  --font-sans: var(--font-inter);
  --font-mono: var(--font-jetbrains-mono);
}

:root {
  --background: #050510;
  --foreground: #F8FAFC;
}

body {
  background: radial-gradient(circle at 50% 50%, #0B0B2E 0%, #050510 100%);
  color: var(--foreground);
  font-family: var(--font-inter), system-ui, -apple-system, sans-serif;
  min-height: 100vh;
  overflow-x: hidden;
}

/* Glassmorphism Styles */
.glass-panel {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1), 0 8px 32px 0 rgba(0, 0, 0, 0.37);
  border-radius: var(--radius-glass);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.glass-panel-hover:hover {
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(255, 255, 255, 0.15);
  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.15), 0 12px 40px 0 rgba(139, 92, 246, 0.15);
  transform: translateY(-2px);
}

.glass-input {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  color: #F8FAFC;
  padding: 12px 16px;
  outline: none;
  transition: all 0.2s ease-in-out;
}

.glass-input:focus {
  border-color: rgba(6, 182, 212, 0.5);
  background: rgba(255, 255, 255, 0.05);
  box-shadow: 0 0 15px rgba(6, 182, 212, 0.2);
}

/* Custom glow text effects */
.glow-text-yes {
  text-shadow: 0 0 12px rgba(16, 229, 140, 0.4);
}

.glow-text-no {
  text-shadow: 0 0 12px rgba(255, 77, 109, 0.4);
}

.glow-text-primary {
  text-shadow: 0 0 15px rgba(139, 92, 246, 0.3);
}

/* Button variants */
.btn-primary {
  background: linear-gradient(135deg, #8B5CF6 0%, #06B6D4 100%);
  color: #F8FAFC;
  font-weight: 600;
  border-radius: 12px;
  padding: 12px 24px;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4px 20px rgba(139, 92, 246, 0.25);
  cursor: pointer;
}

.btn-primary:hover {
  transform: scale(1.02);
  box-shadow: 0 6px 24px rgba(139, 92, 246, 0.4), 0 0 15px rgba(6, 182, 212, 0.3);
}

.btn-primary:active {
  transform: scale(0.97);
}

.btn-yes {
  background: rgba(16, 229, 140, 0.12);
  border: 1px solid rgba(16, 229, 140, 0.3);
  color: #10E58C;
  font-weight: 600;
  border-radius: 12px;
  padding: 12px 24px;
  transition: all 0.2s ease-in-out;
  cursor: pointer;
}

.btn-yes:hover {
  background: rgba(16, 229, 140, 0.2);
  border-color: rgba(16, 229, 140, 0.6);
  box-shadow: 0 0 20px rgba(16, 229, 140, 0.25);
}

.btn-no {
  background: rgba(255, 77, 109, 0.12);
  border: 1px solid rgba(255, 77, 109, 0.3);
  color: #FF4D6D;
  font-weight: 600;
  border-radius: 12px;
  padding: 12px 24px;
  transition: all 0.2s ease-in-out;
  cursor: pointer;
}

.btn-no:hover {
  background: rgba(255, 77, 109, 0.2);
  border-color: rgba(255, 77, 109, 0.6);
  box-shadow: 0 0 20px rgba(255, 77, 109, 0.25);
}

/* Custom Scrollbars */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: rgba(5, 5, 16, 0.5);
}

::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.15);
}

/* Loading animations */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton-shimmer {
  background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.03) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

/* Coin Flip / Success Animations */
@keyframes success-flip {
  0% { transform: rotateY(0deg) scale(1); }
  50% { transform: rotateY(180deg) scale(1.15); }
  100% { transform: rotateY(360deg) scale(1); }
}

.animate-success-flip {
  animation: success-flip 0.8s ease-out;
}
